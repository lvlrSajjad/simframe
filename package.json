{
  "name": "simframe",
  "version": "0.4.1",
  "mcpName": "io.github.lvlrSajjad/simframe",
  "description": "Always-warm iOS Simulator frames: agents read the screen in ~20ms instead of waiting on screenshots. MCP server + CLI.",
  "keywords": [
    "ios",
    "simulator",
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "screenshot",
    "xcode",
    "simctl",
    "agent"
  ],
  "homepage": "https://github.com/lvlrSajjad/simframe#readme",
  "bugs": {
    "url": "https://github.com/lvlrSajjad/simframe/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvlrSajjad/simframe.git"
  },
  "license": "MIT",
  "author": "Sadjad Asadi (https://github.com/lvlrSajjad)",
  "type": "module",
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "bin": {
    "simframe": "src/cli.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "native",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/unit.test.mjs",
    "mcp": "node src/cli.js mcp",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  }
}
