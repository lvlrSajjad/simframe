      "Welcome to Reminders"
    ]
  },
  {
    "name": "contacts",
    "note": "An indexed list with a search field — a nav bar with two rows in it.",
    "steps": [
      {
        "launch": {
          "value": "com.apple.MobileAddressBook",
          "relaunch": true
        }
      },
      {
        "waitFor": "Contacts"
      }
    ],
    "intents": [
      "Kate Bell",
      "Back"
    ]
  },
  {
    "name": "settings-general",
    "note": "With the next screen, the case chrome labels exist for: two lists under a nav bar with near-identical structure, told apart by their title and nothing else. Without a nav title in the fingerprint these collide.",
    "steps": [
      {
        "launch": {
          "value": "com.apple.Preferences",
          "relaunch": true
        }
      },
      {
        "waitFor": "General"
      },
      {
        "tap": "General"
      },
      {
        "waitFor": "About"
      }
    ],
    "intents": [
      "About",
      "Language & Region"
    ]
  },
  {
    "name": "settings-accessibility",
    "note": "The other half of that pair.",
    "steps": [
      {
        "launch": {
          "value": "com.apple.Preferences",
          "relaunch": true
        }
      },
      {
        "waitFor": "Accessibility"
      },
      {
        "tap": "Accessibility"
